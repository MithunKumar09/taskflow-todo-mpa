{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "prisma/**/*.ts",
    "prisma.config.ts",
    "playwright.config.ts"
  ]
}
